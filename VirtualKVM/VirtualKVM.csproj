<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- 기존 .NET Framework 프로젝트의 bin\Debug / bin\x64\Debug 경로 구조 유지 (바로가기/스케줄러 호환) -->
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <Platforms>AnyCPU;x64</Platforms>
    <RootNamespace>VirtualKVM</RootNamespace>
    <AssemblyName>VirtualKVM</AssemblyName>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <Deterministic>true</Deterministic>
    <Version>1.0.0</Version>
    <Product>VirtualKVM</Product>
    <Copyright>Copyright ©  2022</Copyright>
    <ComVisible>false</ComVisible>
    <DebugType>portable</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <!-- System.Security.Cryptography.ProtectedData(DPAPI)는 Windows Desktop SDK에 포함되어 있어 별도 참조 불필요 -->
    <ProjectReference Include="..\RaspberryPi-Lib\RaspberryPi-Lib.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Properties\Resources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
    <Compile Update="UI\WindowMain.Designer.cs">
      <DependentUpon>WindowMain.cs</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
    <EmbeddedResource Update="UI\WindowMain.resx">
      <DependentUpon>WindowMain.cs</DependentUpon>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <None Include="Resources\ico_error.ico" />
    <None Include="Resources\ico_normal.ico" />
    <None Include="Resources\ico_linked.ico" />
  </ItemGroup>

</Project>
