<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- IOControlCode.KeepAliveValues 등 Windows 전용 Socket API를 사용하므로 windows TFM 지정 (CA1416 방지) -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <Platforms>AnyCPU;x64</Platforms>
    <!-- 기존 .NET Framework 프로젝트의 bin\Debug / bin\x64\Debug 경로 구조 유지 -->
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <RootNamespace>RaspberryPi_Lib</RootNamespace>
    <AssemblyName>RaspberryPi-Lib</AssemblyName>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <Deterministic>true</Deterministic>
    <Version>1.0.0</Version>
    <Product>RaspberryPi-Lib</Product>
    <Copyright>Copyright ©  2017</Copyright>
    <ComVisible>false</ComVisible>
    <DebugType>portable</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SSH.NET" Version="2026.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Properties\Resources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
    <None Include="Resources\RaspberryPiZeroW-HID" />
  </ItemGroup>

</Project>
